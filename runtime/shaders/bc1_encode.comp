// RGBA8 texels to BC1 blocks on the GPU, one invocation per 4x4 block: the second pass of the ASTC decode
// when AC_ASTC_BC=bc1 and the alpha scan found the texture opaque (vk_astc.c, astc_block_alpha_possible in
// tex_astc.c), so a provably opaque recompressed texture takes 4 bits per texel in video memory instead of
// BC3's 8. The colour block is the same one bc3_encode.comp writes — the BC3 colour part is a BC1 block: the
// box around the block's colours, its diagonal turned to the sign of the colours' covariance and inset by
// 1/16 of the range (the bounding-box method of stb_dxt and of yuzu's BC1 recompression), then each texel
// takes the nearest of the four palette entries along that axis. Alpha is absent by construction: the scan
// proved every decoded alpha 255, and BC1_RGB samples alpha as 1. Texels past the right or bottom edge
// repeat the last column or row.
// Compiled to runtime/bc1_encode_spv.h by tools/build_shaders.py; vk_astc.c records the dispatch.
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Texels { uint px[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Blocks { uvec2 blk[]; };

layout(push_constant) uniform Params {
    uint in_base;    // first texel of slice 0 (index into px)
    uint out_base;   // first block of slice 0 (uvec2 index into blk)
    uint width, height;
    uint bx;         // blocks per row
    uint bslice;     // blocks per slice
} pc;

vec4 texel(uint x, uint y, uint z) {
    x = min(x, pc.width - 1u), y = min(y, pc.height - 1u);
    return unpackUnorm4x8(px[pc.in_base + (z * pc.height + y) * pc.width + x]) * 255.0;
}

uint to565(vec3 c) {
    uvec3 q = uvec3(round(clamp(c, 0.0, 255.0) * vec3(31.0, 63.0, 31.0) / 255.0));
    return q.r << 11 | q.g << 5 | q.b;
}

vec3 from565(uint v) {
    return vec3(float(v >> 11 & 31u) * 255.0 / 31.0, float(v >> 5 & 63u) * 255.0 / 63.0, float(v & 31u) * 255.0 / 31.0);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    uint by = (pc.height + 3u) / 4u;
    if (id.x >= pc.bx || id.y >= by) return;
    vec3 t[16];
    vec3 lo = vec3(255.0), hi = vec3(0.0), mean = vec3(0.0);
    for (uint i = 0u; i < 16u; i++) {
        t[i] = texel(id.x * 4u + (i & 3u), id.y * 4u + (i >> 2), id.z).rgb;
        lo = min(lo, t[i]), hi = max(hi, t[i]), mean += t[i];
    }
    mean /= 16.0;

    // colour: the box diagonal along the covariance of red and blue with green
    float crg = 0.0, cbg = 0.0;
    for (uint i = 0u; i < 16u; i++) {
        vec3 d = t[i] - mean;
        crg += d.r * d.g, cbg += d.b * d.g;
    }
    if (crg < 0.0) { float s = lo.r; lo.r = hi.r; hi.r = s; }
    if (cbg < 0.0) { float s = lo.b; lo.b = hi.b; hi.b = s; }
    vec3 inset = (hi - lo) / 16.0;
    uint c0 = to565(hi - inset), c1 = to565(lo + inset);
    uint idx = 0u;
    if (c0 != c1) {
        if (c0 < c1) { uint s = c0; c0 = c1; c1 = s; }   // c0 > c1: the four-colour mode
        vec3 e0 = from565(c0), e1 = from565(c1), axis = e1 - e0;
        float len2 = max(dot(axis, axis), 1e-6);
        for (uint i = 0u; i < 16u; i++) {
            uint s = uint(clamp(round(dot(t[i] - e0, axis) / len2 * 3.0), 0.0, 3.0));   // 0 = e0 .. 3 = e1
            uint code = s == 0u ? 0u : s == 3u ? 1u : s + 1u;   // palette order e0, e1, 2/3 e0 + 1/3 e1, 1/3 e0 + 2/3 e1
            idx |= code << (2u * i);
        }
    }
    blk[pc.out_base + id.z * pc.bslice + id.y * pc.bx + id.x] = uvec2(c0 | c1 << 16, idx);
}
