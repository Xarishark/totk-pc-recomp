// AMD FidelityFX Super Resolution 1 robust contrast-adaptive sharpening (RCAS) of the EASU result
// (runtime/vk_fsr.c), or of the game's crop rectangle at the window's size. ffx/ffx_a.h and ffx/ffx_fsr1.h are AMD's headers, unmodified (MIT, ffx/LICENSE.txt).
#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    vec4 size;   // output width, output height, sharpness in stops (0 = most), unused
    vec4 rect;   // the input's rectangle: x, y, width, height
} pc;

#define A_GPU 1
#define A_GLSL 1
#include "ffx/ffx_a.h"
#define FSR_RCAS_F 1
// p is an output pixel: the input pixel is p plus the rectangle's corner. RCAS reads one pixel beyond each edge, so the
// read is clamped to the rectangle: the border repeats instead of reading what lies outside it (another part of the
// game's image, or outside the image, which Vulkan leaves undefined without robustImageAccess).
AF4 FsrRcasLoadF(ASU2 p) {
    ivec2 lo = ivec2(pc.rect.xy), hi = lo + ivec2(pc.rect.zw) - 1;
    return texelFetch(src, clamp(lo + p, lo, hi), 0);
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx/ffx_fsr1.h"

void put(AU2 p, AU4 con) {
    if (p.x >= uint(pc.size.x) || p.y >= uint(pc.size.y)) return;
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, p, con);
    imageStore(dst, ivec2(p), vec4(c, 1.0));
}

void main() {
    AU4 con;
    FsrRcasCon(con, pc.size.z);
    AU2 p = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    put(p, con);
    p.x += 8u;
    put(p, con);
    p.y += 8u;
    put(p, con);
    p.x -= 8u;
    put(p, con);
}
